// UZTT platformasi — Prisma sxema
// Phase 0: identity + RBAC. Keyingi fazalarda domen modellari qo'shiladi.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== IDENTITY & RBAC ====================

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  avatarUrl    String?    @map("avatar_url")
  locale       String     @default("uz")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  registrationActions TournamentRegistration[] @relation("RegistrationStatusActor")
  pointsAdjustments   PlayerPointsLog[]        @relation("PointsAdjustedBy")
  refereeProfile      RefereeProfile?

  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Rollar bazada saqlanadi (enum emas) — yangi rol qo'shish = ma'lumot, kod emas.
model Role {
  id        String   @id @default(uuid())
  code      String   @unique // SUPERADMIN, ADMIN, EDITOR, REFEREE, COACH, PLAYER, ...
  name      String // ko'rsatiladigan nom (default — uz)
  isSystem  Boolean  @default(false) @map("is_system") // tizim rollari o'chirilmaydi
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  code        String @unique // masalan: match.score, news.publish, role.manage
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==================== SPRAVOCHNIKLAR (data-driven) ====================

// Yosh kategoriyalari: muvofiqlik qoidasi — o'yinchi yoshi <= maxAge (yoki maxAge null).
model AgeCategory {
  id        String @id @default(uuid())
  code      String @unique // U9, U11, U13, U15, U17, U19, SENIOR
  name      String
  maxAge    Int?   @map("max_age") // SENIOR uchun null
  sortOrder Int    @default(0) @map("sort_order")

  players              Player[]
  tournaments          Tournament[]
  tournamentCategories TournamentCategory[]
  declaredByPlayers    PlayerAgeCategory[]
  partnerships         Partnership[]
  teams                Team[]

  @@map("age_categories")
}

/// Juftlik / Aralash juftlik reytingi. Bir juftlik = ikki o'yinchi (ba'zan
/// hamkor uttf.uz'da alohida profilga ega bo'lmasligi mumkin — shunda
/// player2Id null qoladi, ism matn sifatida saqlanmaydi, faqat player1
/// ko'rinadi). ageCategoryId manba API'sida yo'q edi — import vaqtida
/// juftlikdagi kattaroq yoshli o'yinchining toifasi bo'yicha hisoblangan.
model Partnership {
  id            String    @id @default(uuid())
  category      EventType // faqat DOUBLES yoki MIXED_DOUBLES
  player1Id     String    @map("player1_id")
  player2Id     String?   @map("player2_id")
  points        Int       @default(0)
  ranking       Int?
  ageCategoryId String?   @map("age_category_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  player1     Player       @relation("PartnershipPlayer1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2     Player?      @relation("PartnershipPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  ageCategory AgeCategory? @relation(fields: [ageCategoryId], references: [id])

  @@index([category, points])
  @@index([ageCategoryId])
  @@map("partnerships")
}

/// Jamoaviy reyting — klub/jamoa darajasidagi umumiy ball (uttf.uz manbasida
/// o'yinchilar tarkibi berilmagan, faqat jamoa nomi + ball + toifa + jins).
/// `gender` null = aralash jamoa ("Males and females").
model Team {
  id            String   @id @default(uuid())
  name          String
  regionName    String?  @map("region_name")
  districtName  String?  @map("district_name")
  gender        Gender?
  ageCategoryId String?  @map("age_category_id")
  points        Int      @default(0)
  ranking       Int?
  externalId    Int?     @map("external_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ageCategory AgeCategory? @relation(fields: [ageCategoryId], references: [id])

  // uttf.uz manbasida bitta jamoa (externalId) har bir yosh toifasi va
  // jinsda alohida qator bo'lib qaytadi (masalan: bitta viloyat jamoasi
  // U15/erkak, U15/ayol, U17/erkak... deb 18 martagacha takrorlanishi
  // mumkin) — shu sabab yagona kalit externalId emas, balki
  // (externalId, ageCategoryId, gender) uchligi.
  @@unique([externalId, ageCategoryId, gender])
  @@index([ageCategoryId, gender, points])
  @@map("teams")
}

// Musobaqa darajasi (koeffitsiyent reyting balliga ko'paytiriladi)
/// Musobaqa darajasi = REGLAMENT. Har daraja o'z ball jadvaliga ega:
/// guruhdagi g'alaba, guruhdan chiqish, setkadagi har bir g'alaba,
/// finalda ishtirok va chempionlik uchun necha ball berilishi.
/// Musobaqa ochilganda daraja tanlanadi va o'yinlar shu reglament bo'yicha
/// ball beradi.
model TournamentLevel {
  id          String  @id @default(uuid())
  code        String  @unique // NATIONAL, REGIONAL, OPEN, CLUB
  name        String
  description String?
  /// Eski (reglamentsiz) darajalar uchun zaxira: bosqich balli × koeffitsiyent
  coefficient Float
  sortOrder   Int     @default(0) @map("sort_order")

  tournaments Tournament[]
  pointsRules LevelPointsRule[]

  @@map("tournament_levels")
}

/// Reglamentdagi ball turlari (to'rtta — sodda va tushunarli)
enum PointRuleKey {
  PARTICIPATION // musobaqada ishtirok etgani uchun (birinchi o'ynagan o'yinda)
  GROUP_ADVANCE // guruhdan chiqib setkaga tushish
  WIN // har bir g'alaba uchun (guruhda ham, setkada ham)
  CHAMPION // finalda g'olib bo'lgani uchun
}

model LevelPointsRule {
  levelId String       @map("level_id")
  key     PointRuleKey
  points  Int

  level TournamentLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@id([levelId, key])
  @@map("level_points_rules")
}

// Bosqich ball jadvali (legacy: final 700, semifinal 450, ...)
model StagePoints {
  stage      MatchStage @id
  basePoints Int        @map("base_points")

  @@map("stage_points")
}

// ==================== O'YINCHILAR ====================

enum Gender {
  MALE
  FEMALE
}

enum PlayerStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
}

model Player {
  id            String       @id @default(uuid())
  slug          String       @unique
  firstName     String       @map("first_name")
  lastName      String       @map("last_name")
  gender        Gender
  birthDate     DateTime?    @map("birth_date") @db.Date
  ageCategoryId String?      @map("age_category_id")
  region        String
  club          String?
  clubId        String?      @map("club_id")
  licenseNumber String?      @unique @map("license_number")
  rankingPoints Int          @default(0) @map("ranking_points") // kesh — manba: PlayerPointsLog
  photoUrl      String?      @map("photo_url")
  countryCode   String       @default("UZ") @map("country_code")
  status        PlayerStatus @default(ACTIVE)
  userId        String?      @unique @map("user_id") // self-registration'da bog'lanadi
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  ageCategory          AgeCategory?             @relation(fields: [ageCategoryId], references: [id])
  clubRecord           Club?                    @relation(fields: [clubId], references: [id])
  pointsLog            PlayerPointsLog[]
  matchesAsP1          Match[]                  @relation("MatchPlayer1")
  matchesAsP2          Match[]                  @relation("MatchPlayer2")
  registrations        TournamentRegistration[]
  partnerEntries       TournamentRegistration[] @relation("RegistrationPartner")
  documents            PlayerDocument[]
  declaredCategories   PlayerAgeCategory[]
  snapshotEntries      RankingSnapshotEntry[]
  partnershipsAsPlayer1 Partnership[]           @relation("PartnershipPlayer1")
  partnershipsAsPlayer2 Partnership[]           @relation("PartnershipPlayer2")

  @@index([gender, rankingPoints])
  @@index([clubId])
  @@map("players")
}

/// Stol tennisi klubi/sport maktabi. uttf.uz'dan import qilingan (Ma'lumotlar migratsiyasi).
model Club {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  clubType    String?  @map("club_type") // masalan: "Professional sport klubi", "Jamoatchilik sport klubi"
  regionName  String?  @map("region_name")
  districtName String? @map("district_name")
  address     String?
  latitude    Float?
  longitude   Float?
  phoneNumber String?  @map("phone_number")
  coachName   String?  @map("coach_name")
  managerName String?  @map("manager_name")
  tableCount  Int?     @map("table_count")
  logoUrl     String?  @map("logo_url")
  externalId  Int?     @unique @map("external_id") // uttf.uz'dagi asl klub ID (qayta importda dublikatning oldini olish uchun)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  players Player[]

  @@map("clubs")
}

/// O'yinchi ro'yxatdan o'tishda o'zi tanlagan yosh toifalari.
/// Admin tasdiqlaganidan keyingina turnirda ishlatiladi (Player.status = ACTIVE).
model PlayerAgeCategory {
  playerId      String @map("player_id")
  ageCategoryId String @map("age_category_id")

  player      Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  ageCategory AgeCategory @relation(fields: [ageCategoryId], references: [id], onDelete: Cascade)

  @@id([playerId, ageCategoryId])
  @@map("player_age_categories")
}

/// Hakam profili: sertifikat darajasi va faoliyat ma'lumotlari.
/// Statistika (o'yinlar soni, kartochkalar) o'yinlar jadvalidan hisoblanadi.
model RefereeProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  certification String? // masalan "Milliy toifa", "Xalqaro"
  region        String?
  since         Int? // faoliyat boshlangan yil
  photoUrl      String?  @map("photo_url")
  bio           String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("referee_profiles")
}

enum PointsLogReason {
  MATCH_WIN
  UNDO
  ADJUSTMENT
}

model PlayerPointsLog {
  id           String          @id @default(uuid())
  playerId     String          @map("player_id")
  delta        Int
  reason       PointsLogReason
  matchId      String?         @map("match_id")
  tournamentId String?         @map("tournament_id")
  // Qo'lda tuzatish uchun: izoh va kim o'zgartirgani
  note         String?
  createdById  String?         @map("created_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("PointsAdjustedBy", fields: [createdById], references: [id])

  @@index([playerId, createdAt])
  @@index([matchId])
  @@map("player_points_log")
}

/// Haftalik reyting kesimi (dushanba tunida cron yozadi, admin qo'lda ham ola oladi).
/// Movement (▲▼) joriy o'rin bilan oxirgi kesimdagi o'rin farqidan hisoblanadi.
model RankingSnapshot {
  id      String   @id @default(uuid())
  label   String   @unique // masalan "2026-W32"
  takenAt DateTime @default(now()) @map("taken_at")
  isAuto  Boolean  @default(true) @map("is_auto")

  entries RankingSnapshotEntry[]

  @@index([takenAt])
  @@map("ranking_snapshots")
}

/// Kesimdagi bitta o'yinchi. Jins/yosh toifasi kesim vaqtidagi holatda saqlanadi —
/// o'yinchi keyin toifa almashtirsa ham tarix buzilmaydi.
model RankingSnapshotEntry {
  id            String  @id @default(uuid())
  snapshotId    String  @map("snapshot_id")
  playerId      String  @map("player_id")
  rank          Int // umumiy ro'yxatdagi o'rin
  points        Int
  gender        Gender
  ageCategoryId String? @map("age_category_id")

  snapshot RankingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  player   Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, playerId])
  @@index([snapshotId, rank])
  @@map("ranking_snapshot_entries")
}

// ==================== MUSOBAQALAR ====================

enum TournamentStatus {
  UPCOMING
  LIVE
  FINISHED
}

model Tournament {
  id             String           @id @default(uuid())
  slug           String           @unique
  name           String
  levelId        String           @map("level_id")
  city           String?
  venue          String?
  gender         Gender?
  ageCategoryId  String?          @map("age_category_id")
  startDate      DateTime         @map("start_date") @db.Date
  endDate        DateTime         @map("end_date") @db.Date
  status         TournamentStatus @default(UPCOMING)
  bannerImageUrl String?          @map("banner_image_url")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  level       TournamentLevel      @relation(fields: [levelId], references: [id])
  ageCategory AgeCategory?         @relation(fields: [ageCategoryId], references: [id])
  matches     Match[]
  categories  TournamentCategory[]
  news        NewsArticle[]
  galleries   Gallery[]
  videos      Video[]
  translations TournamentTranslation[]

  @@index([status, startDate])
  @@map("tournaments")
}

/// Musobaqa nomining tarjimalari.
/// uttf.uz `tournaments/detail` nameUz/nameRu/nameEng beradi — ilgari
/// faqat inglizchasi saqlanardi va sayt uch tilli bo'lsa ham musobaqa
/// nomi hamma tilda inglizcha chiqardi.
/// Sxemadagi boshqa oltita tarjima modeli bilan bir xil naqsh.
model TournamentTranslation {
  id           String @id @default(uuid())
  tournamentId String @map("tournament_id")
  locale       String // uz | ru | en
  name         String

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, locale])
  @@map("tournament_translations")
}

// ==================== O'YINLAR ====================

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

enum MatchStage {
  GROUP
  ROUND_1
  ROUND_OF_32
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  FINAL
}

model Match {
  id           String      @id @default(uuid())
  /// uttf.uz dagi matchId — qayta import dublikat yaratmasligi uchun
  externalId   Int?   @unique @map("external_id")
  tournamentId String      @map("tournament_id")
  stage        MatchStage  @default(ROUND_1)
  tableNumber  Int?        @map("table_number")
  scheduledAt  DateTime?   @map("scheduled_at")
  bestOf       Int         @default(5) @map("best_of")
  status       MatchStatus @default(SCHEDULED)

  player1Id String? @map("player1_id")
  player2Id String? @map("player2_id")
  winnerId  String? @map("winner_id")

  player1SetsWon Int @default(0) @map("player1_sets_won")
  player2SetsWon Int @default(0) @map("player2_sets_won")
  currentSetP1   Int @default(0) @map("current_set_p1")
  currentSetP2   Int @default(0) @map("current_set_p2")

  // Hakam kodi faqat hash ko'rinishida saqlanadi (leak bo'lsa ham yaroqsiz)
  refereeCodeHash     String    @map("referee_code_hash")
  refereeCodeAttempts Int       @default(0) @map("referee_code_attempts")
  refereeCodeLocked   Boolean   @default(false) @map("referee_code_locked")
  refereeVerifiedAt   DateTime? @map("referee_verified_at")
  verifiedByUserId    String?   @map("verified_by_user_id")

  overlayToken String @unique @default(uuid()) @map("overlay_token")

  pointsAwarded            Int     @default(0) @map("points_awarded")
  disqualifiedPlayerId     String? @map("disqualified_player_id")
  disqualificationReason   String? @map("disqualification_reason")
  disqualificationAudioUrl String? @map("disqualification_audio_url")

  // Setka (bracket) maydonlari: g'olib avtomatik keyingi o'yin slotiga o'tadi
  drawId          String? @map("draw_id")
  roundNumber     Int?    @map("round_number") // 1 = birinchi raund
  bracketPosition Int?    @map("bracket_position") // raund ichidagi tartib (1..)
  nextMatchId     String? @map("next_match_id")
  nextMatchSlot   Int?    @map("next_match_slot") // 1 | 2

  // Har mutatsiyada oshadigan monotonik hisoblagich — socket eventlarni tartiblash uchun
  seq Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tournament Tournament   @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1    Player?      @relation("MatchPlayer1", fields: [player1Id], references: [id])
  player2    Player?      @relation("MatchPlayer2", fields: [player2Id], references: [id])
  sets       MatchSet[]
  cards      MatchCard[]
  events     MatchEvent[]

  @@index([tournamentId, status])
  @@index([status])
  @@index([verifiedByUserId])
  // Overlay va zal monitori har necha soniyada shu bo'yicha so'raydi
  @@index([tableNumber, status])
  @@map("matches")
}

model MatchSet {
  id        String @id @default(uuid())
  matchId   String @map("match_id")
  setNumber Int    @map("set_number")
  p1Points  Int    @map("p1_points")
  p2Points  Int    @map("p2_points")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, setNumber])
  @@map("match_sets")
}

enum CardType {
  YELLOW
  RED
}

model MatchCard {
  id             String   @id @default(uuid())
  matchId        String   @map("match_id")
  player         Int // 1 yoki 2
  type           CardType
  setNumber      Int      @map("set_number")
  issuedByUserId String?  @map("issued_by_user_id")
  issuedAt       DateTime @default(now()) @map("issued_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@map("match_cards")
}

enum MatchEventType {
  VERIFY
  POINT
  UNDO
  CARD
  DISQUALIFY
}

// To'liq audit trail. POINT eventining payload'ida amaldan OLDINGI holat
// snapshot'i saqlanadi — undo shu snapshot'ni tiklaydi (legacy semantikasi).
model MatchEvent {
  id          String         @id @default(uuid())
  matchId     String         @map("match_id")
  seq         Int
  type        MatchEventType
  payload     Json?
  actorUserId String?        @map("actor_user_id")
  createdAt   DateTime       @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, seq])
  // Hakam statistikasi shu ustun bo'yicha guruhlanadi
  @@index([actorUserId, type])
  @@map("match_events")
}

// ==================== TURNIR KATEGORIYALARI VA RO'YXATDAN O'TISH ====================

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
  WAITLIST
  WITHDRAWN // turnirdan chetlatilgan (sabab ko'rsatilgan holda)
}

enum RegistrationSource {
  SELF
  ADMIN
  COACH
}

/// Musobaqa guruhi: erkaklar/ayollar yakka, juftlik, aralash juftlik, jamoaviy
enum EventType {
  SINGLES
  DOUBLES
  MIXED_DOUBLES
  TEAM
}

// Turnir ichidagi event: masalan "U-15 o'g'il bolalar yakka"
model TournamentCategory {
  id                   String    @id @default(uuid())
  tournamentId         String    @map("tournament_id")
  ageCategoryId        String    @map("age_category_id")
  gender               Gender? // null = aralash (mixed) yoki ochiq guruh
  eventType            EventType @default(SINGLES) @map("event_type")
  maxEntries           Int?      @map("max_entries")
  registrationDeadline DateTime? @map("registration_deadline")

  tournament    Tournament               @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  ageCategory   AgeCategory              @relation(fields: [ageCategoryId], references: [id])
  registrations TournamentRegistration[]
  draws         Draw[]

  @@unique([tournamentId, ageCategoryId, gender, eventType])
  @@map("tournament_categories")
}

model TournamentRegistration {
  id                   String             @id @default(uuid())
  playerId             String             @map("player_id")
  tournamentCategoryId String             @map("tournament_category_id")
  status               RegistrationStatus @default(PENDING)
  source               RegistrationSource @default(SELF)
  // Juftlik/aralash juftlik uchun sherik, jamoaviy uchun jamoa nomi
  partnerPlayerId      String?            @map("partner_player_id")
  teamName             String?            @map("team_name")
  // Chetlatish/rad etish sababi — MAJBURIY audit izi
  statusReason         String?            @map("status_reason")
  statusChangedById    String?            @map("status_changed_by_id")
  statusChangedAt      DateTime?          @map("status_changed_at")
  registeredAt         DateTime           @default(now()) @map("registered_at")

  player          Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  partner         Player?            @relation("RegistrationPartner", fields: [partnerPlayerId], references: [id])
  statusChangedBy User?              @relation("RegistrationStatusActor", fields: [statusChangedById], references: [id])
  category        TournamentCategory @relation(fields: [tournamentCategoryId], references: [id], onDelete: Cascade)

  @@unique([playerId, tournamentCategoryId])
  // Kategoriya bo'yicha ariza sonlari va ro'yxati
  @@index([tournamentCategoryId, status])
  @@map("tournament_registrations")
}

// ==================== SETKALAR (DRAWS) ====================

enum DrawStatus {
  PENDING
  PUBLISHED
}

model Draw {
  id                   String     @id @default(uuid())
  tournamentCategoryId String     @map("tournament_category_id")
  size                 Int // 8 / 16 / 32 / 64
  status               DrawStatus @default(PENDING)
  createdAt            DateTime   @default(now()) @map("created_at")

  category TournamentCategory @relation(fields: [tournamentCategoryId], references: [id], onDelete: Cascade)
  entries  DrawEntry[]

  @@map("draws")
}

model DrawEntry {
  id       String  @id @default(uuid())
  drawId   String  @map("draw_id")
  playerId String? @map("player_id") // null = bye
  seed     Int?
  position Int // 1..size — setkadagi joy

  draw Draw @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@unique([drawId, position])
  @@map("draw_entries")
}

// ==================== MAXFIY HUJJATLAR (AES-256) ====================

enum PlayerDocumentType {
  PASSPORT
  ID_CARD
  BIRTH_CERTIFICATE
}

// Pasport ma'lumotlari: raqam shifrlangan ustunda, fayl shifrlangan holda
// uploads/private/ da. Public/EDITOR DTO'larga HECH QACHON chiqmaydi.
model PlayerDocument {
  id                String             @id @default(uuid())
  playerId          String             @map("player_id")
  type              PlayerDocumentType
  documentNumberEnc String?            @map("document_number_enc") // CryptoService AES-256-GCM
  filePathEnc       String?            @map("file_path_enc") // shifrlangan fayl yo'li
  expiryDate        DateTime?          @map("expiry_date") @db.Date
  uploadedById      String?            @map("uploaded_by_id")
  createdAt         DateTime           @default(now()) @map("created_at")

  player     Player              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  accessLogs DocumentAccessLog[]

  @@index([playerId])
  @@map("player_documents")
}

model DocumentAccessLog {
  id         String   @id @default(uuid())
  documentId String   @map("document_id")
  userId     String   @map("user_id")
  action     String // VIEW | DOWNLOAD
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  document PlayerDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_access_logs")
}

// ==================== MURABBIY (rol profili pattern'i) ====================

// Har rolga profil: COACH roli uchun profil + o'z o'quvchilari ro'yxati.
// Yangi rol profili qo'shish retsepti: shu pattern takrorlanadi.
model CoachProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  club          String?
  licenseNumber String?  @map("license_number")
  bio           String?
  createdAt     DateTime @default(now()) @map("created_at")

  players CoachPlayer[]

  @@map("coach_profiles")
}

model CoachPlayer {
  coachId  String   @map("coach_id")
  playerId String   @map("player_id")
  addedAt  DateTime @default(now()) @map("added_at")

  coach CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@id([coachId, playerId])
  @@map("coach_players")
}

// ==================== TRANSLATSIYA (OVERLAY / MONITOR) ====================

enum StreamChannelType {
  OVERLAY // YouTube/OBS uchun shaffof scorebug
  SCREEN // zaldagi katta monitor
}

/**
 * Rol profili pattern'i: STREAM va SCREEN akkauntlari qaysi stolga
 * biriktirilganini saqlaydi. Har stolga bittadan: hakam + overlay + monitor.
 */
model StreamProfile {
  id          String            @id @default(uuid())
  userId      String            @unique @map("user_id")
  type        StreamChannelType
  tableNumber Int               @map("table_number")
  label       String?
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([type, tableNumber])
  @@map("stream_profiles")
}

// ==================== MEDIA VA KONTENT (Phase 3) ====================

model Video {
  id           String    @id @default(uuid())
  youtubeId    String    @map("youtube_id") // faqat ID saqlanadi, embed URL emas
  category     String? // highlights | interview | training | ...
  tournamentId String?   @map("tournament_id")
  isFeatured   Boolean   @default(false) @map("is_featured")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  translations VideoTranslation[]
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([tournamentId])
  @@map("videos")
}

model VideoTranslation {
  id      String @id @default(uuid())
  videoId String @map("video_id")
  locale  String
  title   String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, locale])
  @@map("video_translations")
}

enum GalleryStatus {
  DRAFT
  PUBLISHED
}

model Gallery {
  id           String        @id @default(uuid())
  tournamentId String?       @map("tournament_id")
  coverUrl     String?       @map("cover_url")
  status       GalleryStatus @default(PUBLISHED)
  publishedAt  DateTime?     @map("published_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  translations GalleryTranslation[]
  photos       Photo[]
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("galleries")
}

model GalleryTranslation {
  id        String @id @default(uuid())
  galleryId String @map("gallery_id")
  locale    String
  title     String

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@unique([galleryId, locale])
  @@map("gallery_translations")
}

model Photo {
  id        String  @id @default(uuid())
  galleryId String  @map("gallery_id")
  url       String
  thumbUrl  String? @map("thumb_url")
  width     Int?
  height    Int?
  sortOrder Int     @default(0) @map("sort_order")
  credit    String?

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("photos")
}

enum StaffType {
  EXECUTIVE
  STAFF
}

model StaffProfile {
  id        String    @id @default(uuid())
  type      StaffType
  photoUrl  String?   @map("photo_url")
  email     String?
  phone     String?
  sortOrder Int       @default(0) @map("sort_order")

  translations StaffTranslation[]

  @@map("staff_profiles")
}

model StaffTranslation {
  id       String  @id @default(uuid())
  staffId  String  @map("staff_id")
  locale   String
  fullName String  @map("full_name")
  position String
  bio      String?

  staff StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, locale])
  @@map("staff_translations")
}

enum DocumentCategory {
  TECHNICAL
  MEDIA
  LEGAL
}

model FederationDocument {
  id          String           @id @default(uuid())
  category    DocumentCategory
  fileUrl     String           @map("file_url")
  fileSize    Int?             @map("file_size")
  mimeType    String?          @map("mime_type")
  publishedAt DateTime         @default(now()) @map("published_at")

  translations FederationDocumentTranslation[]

  @@map("federation_documents")
}

model FederationDocumentTranslation {
  id         String @id @default(uuid())
  documentId String @map("document_id")
  locale     String
  title      String

  document FederationDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, locale])
  @@map("federation_document_translations")
}

model Sponsor {
  id         String  @id @default(uuid())
  name       String
  logoUrl    String? @map("logo_url")
  websiteUrl String? @map("website_url")
  tier       Int     @default(1) // 1 = bosh homiy
  sortOrder  Int     @default(0) @map("sort_order")

  @@map("sponsors")
}

/// Statik sahifalar (maxfiylik siyosati, foydalanish shartlari, nizom matni...).
/// Kalit orqali ochiladi: /sahifa/privacy. Matn markdown'da saqlanadi.
model Page {
  id        String   @id @default(uuid())
  key       String   @unique // privacy | terms | ...
  isSystem  Boolean  @default(false) @map("is_system") // o'chirib bo'lmaydi
  showInFooter Boolean @default(true) @map("show_in_footer")
  sortOrder Int      @default(0) @map("sort_order")
  updatedAt DateTime @updatedAt @map("updated_at")

  translations PageTranslation[]

  @@map("pages")
}

model PageTranslation {
  id     String @id @default(uuid())
  pageId String @map("page_id")
  locale String
  title  String
  body   String // markdown

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@map("page_translations")
}

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  subject   String?
  body      String
  locale    String        @default("uz")
  status    ContactStatus @default(NEW)
  ip        String?
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("contact_messages")
}

enum MediaKind {
  IMAGE
  DOCUMENT
}

// Yuklangan fayllar registri (sharp variantlari bilan)
model MediaAsset {
  id           String    @id @default(uuid())
  kind         MediaKind
  url          String
  thumbUrl     String?   @map("thumb_url")
  width        Int?
  height       Int?
  size         Int
  mimeType     String    @map("mime_type")
  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("media_assets")
}

// ==================== YANGILIKLAR ====================

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model NewsArticle {
  id            String     @id @default(uuid())
  status        NewsStatus @default(DRAFT)
  category      String?
  coverImageUrl String?    @map("cover_image_url")
  isFeatured    Boolean    @default(false) @map("is_featured")
  // Musobaqaga bog'langan yangilik — event sahifasidagi "Yangiliklar" tabi
  tournamentId  String?    @map("tournament_id")
  publishedAt   DateTime?  @map("published_at")
  authorId      String?    @map("author_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  translations NewsTranslation[]
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([tournamentId])
  @@map("news_articles")
}

model NewsTranslation {
  id        String  @id @default(uuid())
  articleId String  @map("article_id")
  locale    String // uz | ru | en
  title     String
  slug      String
  excerpt   String?
  body      String
  /// Postgres FTS ustuni — GENERATED ALWAYS (migratsiyada yaratiladi, qo'lda yozilmaydi).
  /// Prisma uni bilib turishi kerak, aks holda keyingi diff DROP COLUMN yozadi.
  searchVector Unsupported("tsvector")? @map("search_vector")

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@unique([locale, slug])
  @@map("news_translations")
}
