# ==== Postgres ====
POSTGRES_USER=uztt
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=uztt
# Hostdan ulanish uchun (dev): localhost:5432; konteyner ichida: postgres:5432
DATABASE_URL=postgresql://uztt:change-me-strong-password@localhost:5432/uztt?schema=public

# ==== API ====
API_PORT=4000
# 32+ belgili tasodifiy satr — MAJBURIY, defaulti yo'q (bo'lmasa API boot qilmaydi)
JWT_SECRET=
JWT_REFRESH_SECRET=
# JWT muddatlari
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# AES-256-GCM kalit: aynan 64 ta hex belgi (32 bayt). Generatsiya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# Faol kalit ID (key rotation uchun)
DATA_ENCRYPTION_KEY_ID=k1

# ==== Web ====
WEB_PORT=3100
# Brauzerga ko'rinadigan API manzili (prod: https://domen.uz — nginx orqali)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side fetch uchun (konteynerda: http://api:4000)
API_INTERNAL_URL=http://localhost:4000
# Saytning tashqi manzili (sitemap/robots uchun)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# CORS allowlist (vergul bilan)
WEB_ORIGIN=http://localhost:3100

# ==== Chegaralar ====
# Global so'rov chegarasi (IP bo'yicha). Zalda hamma bitta NAT orqasida
# bo'lsa ko'taring; simulyatsiya/yuklama testida vaqtincha juda katta qiling.
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000

# ==== Kuzatuv (ixtiyoriy) ====
# Shu chegaradan uzun HTTP so'rovlar logga yoziladi (ms, 0 — o'chirilgan)
SLOW_REQUEST_MS=500
# Shu chegaradan uzun SQL so'rovlar logga yoziladi (ms, 0 — o'chirilgan).
# Faqat sabab qidirilayotganda yoqing — har so'rovni kuzatish yuk beradi.
SLOW_QUERY_MS=0

# ==== ISR (kontent keshini yangilash) ====
# API kontent o'zgarganda web'ning revalidate endpointini chaqiradi.
# Ikkalasi birga bo'lishi shart; sir kamida 16 belgi.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Docker'da: http://web:3000/api/revalidate
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=

# ==== Production qo'shimchalari (docker-compose.prod.yml) ====
# Birinchi ishga tushirishda 1, keyin 0 qiling
SEED_ON_BOOT=1
# Production (NODE_ENV=production) da seed ATAYLAB ishlamaydi. Haqiqatan
# kerak bolsa ikkalasini ham bering:
#   SEED_ALLOW_PROD=1
# va SUPERADMIN parollari (kamida 12 belgi, fallback YOQ):
#   SEED_ADMIN_PASSWORD=
#   SEED_ROOT_PASSWORD=
# Production da faqat shu ikki hisob yaratiladi; operator/hakam/muharrir kabi
# demo hisoblar yaratilmaydi — ularni admin panel orqali qoshing.
# Backup shifrlash paroli (openssl aes-256-cbc)
BACKUP_PASSPHRASE=
